# Database
DATABASE_URL=postgresql://safetywork:password@localhost:5432/safetywork
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000

# Notifications
SENDGRID_API_KEY=your-sendgrid-key
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+972XXXXXXXXX
WHATSAPP_API_TOKEN=your-whatsapp-token

# Storage (S3-compatible)
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=safetywork-files
S3_REGION=eu-west-1

# AI
ANTHROPIC_API_KEY=your-anthropic-key

# Keycloak SSO
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=safetywork
KEYCLOAK_CLIENT_ID=safetywork-app
KEYCLOAK_CLIENT_SECRET=your-keycloak-secret

# System Admin
SYSTEM_ADMIN_EMAIL=admin@safetywork.co.il
SYSTEM_ADMIN_PASSWORD=change-me-in-production
